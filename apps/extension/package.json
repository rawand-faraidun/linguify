{
	"name": "linguify-vs",
	"displayName": "Linguify",
	"version": "0.0.0",
	"description": "Developer-first translation file manager, in the editor.",
	"publisher": "rawand-faraidun",
	"private": true,
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@linguify/api": "workspace:*",
		"@linguify/biome-config": "workspace:*",
		"@linguify/constants": "workspace:*",
		"@linguify/table": "workspace:*",
		"@linguify/tsconfig": "workspace:*",
		"@linguify/types": "workspace:*",
		"@types/node": "catalog:",
		"@types/vscode": "1.90.0",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"activationEvents": [
		"workspaceContains:**/linguify.config.json"
	]
}
